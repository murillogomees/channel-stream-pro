# =============================================================================
# Supabase Sync Configuration
# Copie para sync-config.env e configure suas credenciais
# =============================================================================

# =============================================================================
# CLOUD DATABASE (Origem - Produção)
# =============================================================================

# Connection String do Supabase Cloud
# Encontre em: https://supabase.com/dashboard/project/waxgowafohlrfoefwhsf/settings/database
# Clique em "Connection string" → "URI"
CLOUD_DB_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"

# Alternativa: Componentes separados
CLOUD_HOST="db.waxgowafohlrfoefwhsf.supabase.co"
CLOUD_PORT="5432"
CLOUD_USER="postgres"
CLOUD_PASSWORD="YOUR_SUPABASE_DB_PASSWORD"
CLOUD_DATABASE="postgres"


# =============================================================================
# LOCAL DATABASE (Destino - Desenvolvimento)
# =============================================================================

# Connection String do Supabase Local (padrão após `supabase start`)
LOCAL_DB_URL="postgresql://postgres:postgres@localhost:54322/postgres"

# Alternativa: Componentes separados
LOCAL_HOST="localhost"
LOCAL_PORT="54322"
LOCAL_USER="postgres"
LOCAL_PASSWORD="postgres"
LOCAL_DATABASE="postgres"


# =============================================================================
# OPÇÕES DE EXPORTAÇÃO
# =============================================================================

# Excluir tabelas de logs (recomendado para dev)
EXCLUDE_LOGS=true

# Excluir tabelas de métricas
EXCLUDE_METRICS=true

# Comprimir arquivos grandes (>10MB)
COMPRESS_LARGE_FILES=true

# Diretório de exports
EXPORT_DIR="./exports"

# Formato de export (sql ou csv)
EXPORT_FORMAT="sql"


# =============================================================================
# OPÇÕES DE IMPORTAÇÃO
# =============================================================================

# Limpar tabelas antes de importar
TRUNCATE_BEFORE_IMPORT=true

# Continuar em caso de erro
FORCE_IMPORT=false

# Verificar integridade após import
VERIFY_AFTER_IMPORT=true


# =============================================================================
# TABELAS ESPECÍFICAS (opcional)
# =============================================================================

# Lista de tabelas para exportar/importar (vazio = todas)
# Separar por vírgula, sem espaços
# SPECIFIC_TABLES="profiles,user_roles,clientes"


# =============================================================================
# BACKUP
# =============================================================================

# Manter backups anteriores
KEEP_BACKUPS=5

# Diretório de backups
BACKUP_DIR="./backups"


# =============================================================================
# AVANÇADO
# =============================================================================

# Timeout para queries grandes (segundos)
QUERY_TIMEOUT=300

# Número de conexões paralelas
PARALLEL_CONNECTIONS=4

# Modo verbose (debug)
VERBOSE=false
